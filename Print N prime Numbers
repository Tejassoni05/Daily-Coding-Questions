//Print N prime number
class Main {
    public static void main(String[] args) {
        int n = 8;
        int countPrime= 0;
        int num = 1;
        
        if(num == 1){
            System.out.print(" 1 is not a prime number");
            
        }
        
        while(countPrime< n)
        {
            int factorCount= 0 ;
            
            for(int i = 1; i<=num; i++){
                if(num%i==0){
                    factorCount++;
                }     
                }
                if(factorCount==2)
                {
                    System.out.print(num+ " ");
                    countPrime++;
                }
                num++;
            
        }
        
    }
}
